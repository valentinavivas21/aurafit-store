<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" width="100%" height="100%">
  <defs>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFF1E8"/>
      <stop offset="50%" stop-color="#FFE3CD"/>
      <stop offset="100%" stop-color="#FBDDC5"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#C9A96E" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#C9A96E" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="400" height="500" fill="url(#g)"/>
  <circle cx="200" cy="210" r="130" fill="url(#glow)"/>
  <circle cx="200" cy="210" r="70" fill="none" stroke="#C9A96E" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6"/>
  <text x="50%" y="46%" text-anchor="middle" dominant-baseline="middle" font-family="'Cormorant Garamond', Georgia, serif" font-size="78" font-weight="600" fill="#27180A" opacity="0.85">AF</text>
  <text x="50%" y="54%" text-anchor="middle" font-family="'DM Sans', sans-serif" font-size="11" font-weight="700" letter-spacing="4" fill="#6F5100" text-transform="uppercase">AURA FIT</text>
  <text x="50%" y="60%" text-anchor="middle" font-family="'DM Sans', sans-serif" font-size="9" font-weight="500" letter-spacing="2" fill="#807665" text-transform="uppercase">Activewear Collection</text>
</svg>
